extends layout.pug 

block content 
  h2 Mensajes 

  if conversaciones.length > 0
    each conv in conversaciones
      .card.mb-2 
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h5= conv.usuario.nombre
              p.mb-1= conv.ultimoMensaje.contenido ? conv.ultimoMensaje.contenido.substring(0,100) + '...' : '' 
              small.text-muted= conv.ultimoMensaje.fecha.toLocaleString()
            .text-end
              if conv.noLeidos > 0
                span.badge.bg-danger.me-2= conv.noLeidos 
              a.btn.btn-sm.btn-primary(href=`/mensajes/conversacion/${conv.usuario.id}`) Ver chat
  else
    .alert.alert-info No tienes mensajes.