extends layout.pug

block content
  .row.justify-content-center
    .col-md-4
      h2.mb-3 Iniciar sesión
      if error
        .alert.alert-danger= error
      form(action="/login" method="POST")
        .mb-3
          label.form-label(for="email") Email
          input#email.form-control(type="email" name="email" value=email required autofocus)
        .mb-3
          label.form-label(for="password") Contraseña
          input#password.form-control(type="password" name="password" required)
        button.btn.btn-primary.w-100(type="submit") Ingresar
      p.mt-3 ¿No tenés cuenta?
        a.ms-1(href="/registro") Registrate