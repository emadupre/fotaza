doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Fotaza
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/estilos.css")
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.shadow-sm.mb-4
      .container
        a.navbar-brand.fw-bold(href="/")
          i.bi.bi-camera.me-2
          | Fotaza
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href="/buscar")
                i.bi.bi-search.me-1
                | Buscar
            if usuario
              li.nav-item
                a.nav-link(href="/")
                  i.bi.bi-house-door.me-1
                  | Inicio
              li.nav-item
                a.nav-link(href="/publicar")
                  i.bi.bi-plus-circle.me-1
                  | Publicar
              li.nav-item
                a.nav-link(href="/notificaciones")
                  i.bi.bi-bell.me-1
                  | Notificaciones
              li.nav-item
                a.nav-link(href="/mensajes")
                  i.bi.bi-chat-dots.me-1
                  | Mensajes
              li.nav-item
                a.nav-link(href="/colecciones")
                  i.bi.bi-collection.me-1
                  | Colecciones
              if usuario.rol === 'validador'
                li.nav-item
                  a.nav-link(href="/validador")
                    i.bi.bi-shield-check.me-1
                    | Panel Validador
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown")
                  i.bi.bi-person-circle.me-1
                  = usuario.nombre
                ul.dropdown-menu.dropdown-menu-end
                  li
                    a.dropdown-item(href="/perfil")
                      i.bi.bi-person.me-2
                      | Mi Perfil
                  li
                    a.dropdown-item(href="/mis-denuncias")
                      i.bi.bi-flag.me-2
                      | Denuncias recibidas
                  li
                    hr.dropdown-divider
                  li
                    a.dropdown-item(href="/logout")
                      i.bi.bi-box-arrow-right.me-2
                      | Cerrar Sesión
            else
              li.nav-item
                a.nav-link(href="/login")
                  i.bi.bi-box-arrow-in-right.me-1
                  | Iniciar Sesión
              li.nav-item
                a.nav-link(href="/registro")
                  i.bi.bi-person-plus.me-1
                  | Registrarse

    .container
      if aviso
        .alert(class=`alert-${aviso.tipo}` role="alert")= aviso.texto
      block content

    footer.bg-dark.text-white.text-center.py-3.mt-5
      .container
        p.mb-0 Fotaza by Jesús Emanuel García

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js")