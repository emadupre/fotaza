doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Fotaza 
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4 
      .container 
        a.navbar-brand(href="/") Fotaza 
        button.navbar-toggler(type="button" data-bootstrap-toggle="collapse" data-bs-target="#navbarNav")
          span.navbar-toggler-icon 
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto 
            if usuario 
              li.nav-item 
                a.nav-link(href="/buscar") Buscar 
              li.nav-item 
                a.nav-link(href="/publicar") Publicar
              li.nav-item 
                a.nav-link(href="/perfil") Mi Perfil 
              li.nav-item 
                a.nav-link(href="/logout") Cerrar Sesion
            else
              li.nav-item 
                a.nav-link(href="/buscar") Buscar
              li.nav-item
                a.nav-link(href="/login") Iniciar Sesion 
              li.nav-item 
                a.nav-link(href="/registro") Registrate 
              
    .container
        block content 

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")