extends layout.pug 

block content 
  .row 
    .col-md-4 
      .card 
        .card-body.text-center 
          h3= usuarioPerfil.nombre 
          p.text-muted= usuarioPerfil.biografia || 'Sin biografia'
          p 
            strong Email: 
            |   #{usuarioPerfil.email}
          p 
            strong Rol: 
            |   #{usuarioPerfil.rol}
          p 
            strong Seguidores: 
            |   #{seguidores}
          p 
            strong Siguiendo: 
            |   #{seguidos}
          if esPropioPerfil 
            a.btn.btn-outline-primary(href="/perfil/editar") Editar Perfil 
          else
            if !esPropioPerfil
              a.btn.btn-outline-secondary.ms-2(href=`/mensajes/conversacion/${usuarioPerfil.id}`) Enviar Mensaje
            if yaSigo 
              form(action=`/dejar-de-seguir/${usuarioPerfil.id}` method="POST")
                button.btn.btn-outline-danger(type="submit") Dejar de seguir
            else 
              form(action=`/seguir/${usuarioPerfil.id}` method="POST")
                button.btn.btn-primary(type="submit") Seguir
    .col-md-8 
      h3 Publicaciones 
      if publicaciones.length > 0
        .row
          each pub in publicaciones 
            .col-md-6.mb-3 
              .card 
                .card-body 
                  h5= pub.titulo 
                  p.text-muted= pub.fecha_creacion 
                  a.btn.btn-sm.btn-primary(href=`/publicaciones/${pub.id}`) Ver 
      else 
        p No hay publicaciones todavía.