extends layout.pug 

block content 
  .row-justify-content-center 
    .col-md-4 
      h2 Registrarse 
      if error
        .alert.alert-danger= error
    form(action="/registro" method="POST")
      .mb-3 
        label.form-label(for="nombre") Nombre 
        input#nombre.form-control(type="text" name="nombre" required)
      .mb-3 
        label.form-label(for="email") Email 
        input#email.form-control(type="email" name="email" required)
      .mb-3 
        label.form-label(for="password") Contraseña
        input#password.form-control(type="password" name="password" required)
      button.btn.btn-primary.w-100(type="submit") Crear Cuenta
    p.mt-3 Ya tenes una cuenta?
      a(href="/login") Inicia sesion