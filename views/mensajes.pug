extends layout.pug 

block content 
  h2 Mensajes 

  if mensajes.length > 0
    each msg in mensajes 
      .card.mb-2 
        .card-body 
          if msg.remitente_id === usuario.id 
            p 
              strong Para: #{msg.destinatario.nombre}
          else 
            p 
              strong De: #{msg.remitente.nombre}
          p.mb-1= msg.contenido 
          small.text-muted= msg.fecha.toLocaleString()
          if !msg.leido && msg.destinatario_id === usuario.id 
            span.badge.bg-warning.ms-2 Nuevo 
  else 
    .alert.alert-info No tienes mensajes.