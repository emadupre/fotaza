extends layout.pug

block content
  .row.justify-content-center
    .col-md-4
      h2.mb-3 Registrarse
      if error
        .alert.alert-danger= error
      form(action="/registro" method="POST")
        .mb-3
          label.form-label(for="nombre") Nombre
          input#nombre.form-control(type="text" name="nombre" value=nombre minlength="2" maxlength="100" required)
        .mb-3
          label.form-label(for="email") Email
          input#email.form-control(type="email" name="email" value=email maxlength="255" required)
        .mb-3
          label.form-label(for="password") Contraseña
          input#password.form-control(type="password" name="password" minlength="6" maxlength="72" required)
          .form-text Entre 6 y 72 caracteres
        button.btn.btn-primary.w-100(type="submit") Crear cuenta
      p.mt-3 ¿Ya tenés cuenta?
        a.ms-1(href="/login") Iniciá sesión